# Environment Configuration Example
# Copy this file to .env and adjust your parameters
DEBUG=True
SECRET_KEY=django-insecure-growup-manga-anime-novels-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration:
# Leave blank or omit to use default SQLite fallback, or provide Prisma Postgres / PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
PRISMA_POSTGRES_TOKEN=your_prisma_postgres_token_here
DATABASE_URL=

# Jikan API v4 Configuration
JIKAN_API_BASE_URL=https://api.jikan.moe/v4
JIKAN_API_TIMEOUT=6
JIKAN_CACHE_TTL=900
JIKAN_TOP_LIMIT=12
JIKAN_SEARCH_LIMIT=18
