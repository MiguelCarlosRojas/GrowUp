# Environment Configuration Example
# Copy this file to .env and adjust your parameters
DEBUG=True
SECRET_KEY=django-insecure-growup-manga-anime-novels-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Prisma Postgres / PostgreSQL)
PRISMA_POSTGRES_TOKEN=your_prisma_postgres_token_here
DATABASE_URL=postgres://user:password@pooled.db.prisma.io:5432/postgres?sslmode=require

# External APIs Configuration
JIKAN_API_BASE_URL=https://api.jikan.moe/v4

# JSON Web Token (JWT) Configuration
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# OAuth 2.0 Providers Configuration
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

